    "q = np.linspace(0.5, 3, 1000)\n",
    "I = (np.exp(-(q - pi/2)**2 / 0.2**2)) * q ** 2\n",
    "\n",
    "plt.plot(q, I)\n",
    "plt.show()\n",
    "\n",
    "r, gamma = corr_func(q, I, res = 10)  # в 10 раз чаще\n",
    "\n",
    "mask = r <= 30\n",
    "plt.plot(r[mask], gamma[mask])\n",
    "plt.show()"
